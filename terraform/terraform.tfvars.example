# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to source control.

# AWS Configuration
aws_region = "us-east-1"

# Application Configuration
app_name = "choir-scheduler"
environment = "production"  # options: dev, staging, production

# VPC and Networking
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.10.0/24", "10.0.11.0/24"]

# Container Configuration
container_port   = 8080
container_cpu    = "512"      # options: 256, 512, 1024, 2048, 4096
container_memory = "1024"     # options: 512, 1024, 2048, 3072, 4096, 5120, 6144, 7168, 8192

# ECS Auto-scaling
desired_count = 2
min_capacity  = 1
max_capacity  = 10

# RDS PostgreSQL Configuration
db_engine_version   = "15.3"
db_instance_class   = "db.t3.micro"      # upgrade for production load
db_allocated_storage = 20                 # in GB
db_name             = "choir"
db_user             = "choir_app"
db_password         = "CHANGE_ME_BEFORE_APPLYING"  # use a strong random password
db_multi_az         = false               # set to true for production
db_deletion_protection = false            # set to true for production
skip_final_snapshot = false               # set to false for production

# Logging
log_retention_days = 7
