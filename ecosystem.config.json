{
  "apps": [
    {
      "name": "choir-scheduler",
      "script": "dist/server.js",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "error_file": "logs/pm2-error.log",
      "out_file": "logs/pm2-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "ignore_watch": ["node_modules", "logs"],
      "listen_timeout": 3000,
      "kill_timeout": 5000,
      "wait_ready": true,
      "max_restarts": 10,
      "min_uptime": "10s"
    }
  ]
}
