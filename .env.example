# Runtime environment
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (required outside tests)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/choir_scheduler

# JWT signing secret (required in all environments)
JWT_SECRET=replace-with-a-long-random-secret

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional local seed user (non-production only)
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=password123

# Optional app-level settings referenced in config
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Email notifications (optional — omit to disable email sending)
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=Choir Scheduler <your-email@gmail.com>
# Optional: override recipients (comma-separated). Defaults to all users in DB.
# EMAIL_RECIPIENTS=person1@example.com,person2@example.com
