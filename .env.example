# Runtime environment
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (required outside tests)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/choir_scheduler

# JWT signing secret (required in all environments)
JWT_SECRET=replace-with-a-long-random-secret

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional local seed user (non-production only)
SEED_USER_EMAIL=test@example.com
SEED_USER_PASSWORD=password123

# Optional app-level settings referenced in config
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
