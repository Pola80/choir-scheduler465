{
  "name": "choir-scheduler",
  "version": "2.0.0",
  "description": "A comprehensive choir event and member management system",
  "main": "dist/server.js",
  "scripts": {
    "dev:api": "npm run build:api && node dist/server.js",
    "dev:client": "cd client && npm run dev",
    "build:api": "tsc",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:client && npm run build:api",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "echo \"No linter configured\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ]
  },
  "keywords": [
    "choir",
    "scheduler",
    "events",
    "members"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.19.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.2"
  }
}
